# =============================================
# DepLao Premium - Root .gitignore
# =============================================

# =============== General ===============
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo
*~

# =============== IDE ===============
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# =============== Java / Spring Boot ===============
backend/spring-boot-api/target/
*.class
*.jar
!frontend/mobile-app/android/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# =============== Node.js ===============
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============== Environment ===============
.env
.env.local
.env.*.local
!.env.example

# =============== Build outputs ===============
dist/
build/
out/

# =============== React Native / Expo ===============
frontend/mobile-app/.expo/
frontend/mobile-app/android/app/build/
frontend/mobile-app/ios/Pods/

# =============== Docker ===============
docker-compose.override.yml

*.apk