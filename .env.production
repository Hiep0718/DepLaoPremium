# ╔══════════════════════════════════════════╗
# ║   DepLao Premium — Production Env       ║
# ╚══════════════════════════════════════════╝

# ── Server ──
EC2_PUBLIC_IP=<YOUR_EC2_PUBLIC_IP>

# ── Database ──
MARIADB_PASSWORD=<STRONG_PASSWORD_HERE>

# ── JWT ──
JWT_SECRET=<GENERATE_64_CHAR_RANDOM_STRING>

# ── CORS (Set to your EC2 IP or domain) ──
CORS_ORIGIN=http://<YOUR_EC2_PUBLIC_IP>

# ── AI Service ──
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ── AWS S3 (nếu dùng upload file) ──
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=lab456-demo-bucket
